# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Database, Auth, and Storage)
# The REST URL for your Supabase project (e.g. https://your-project.supabase.co)
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Supabase Secret / Service Role Key (sb_secret_... or legacy service_role JWT)
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres Database connection parameters
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=

# CLIENT-SIDE SUPABASE & EDGE FUNCTIONS (Vite Exposed)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_TRAIN_API_FUNCTION="train-api"


# ==============================================================================
# BACKEND-ONLY SUBSCRIPTION & PAYMENT GATEWAY CONFIGURATION
# (SECURITY MANDATE: NEVER DISPLAY OR EXPOSE SUBSCRIPTION FEES AT FRONTEND)
# ==============================================================================
# Controls whether any subscription fee UI is permitted on the client (Default: false)
ENABLE_FRONTEND_SUBSCRIPTION_FEE="false"

# Partner subscription annual/monthly fee amount in INR (managed and charged strictly on backend/ERP)
PARTNER_SUBSCRIPTION_FEE_INR="0"

# Default partner tier assignment configured at backend level (e.g., FREE, STANDARD, PRO, ENTERPRISE)
DEFAULT_PARTNER_SUBSCRIPTION_PLAN="PRO"

# Backend Payment Gateway Secrets (processed strictly server-side, never exposed to browser)
PAYMENT_GATEWAY_PROVIDER="CASHFREE"
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=


# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# POSTGRESQL DATABASE CONFIGURATION (Standard DB Credentials)
# ==============================================================================
DATABASE_URL="postgresql://bharatyatra_user:strongpassword123@localhost:5432/bharatyatra_db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bharatyatra_user
POSTGRES_PASSWORD=strongpassword123
POSTGRES_DB=bharatyatra_db


# ==============================================================================
# BACKEND-ONLY SUBSCRIPTION & PAYMENT GATEWAY CONFIGURATION
# (SECURITY MANDATE: NEVER DISPLAY OR EXPOSE SUBSCRIPTION FEES AT FRONTEND)
# ==============================================================================
# Controls whether any subscription fee UI is permitted on the client (Default: false)
ENABLE_FRONTEND_SUBSCRIPTION_FEE="false"

# Partner subscription annual/monthly fee amount in INR (managed and charged strictly on backend/ERP)
PARTNER_SUBSCRIPTION_FEE_INR="0"

# Default partner tier assignment configured at backend level (e.g., FREE, STANDARD, PRO, ENTERPRISE)
DEFAULT_PARTNER_SUBSCRIPTION_PLAN="PRO"

# Backend Payment Gateway Secrets (processed strictly server-side, never exposed to browser)
PAYMENT_GATEWAY_PROVIDER="CASHFREE"
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

